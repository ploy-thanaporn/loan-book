# รหัสผ่านเข้าหน้า /admin
ADMIN_PASSWORD=change-me

PORT=3000
TIMEZONE=Asia/Bangkok

# ที่อยู่เว็บที่ฝังใน QR (ใส่เมื่อ deploy แล้ว เช่น https://loan-qr.onrender.com)
# ถ้าเว้นว่าง ตอนรันในเครื่องจะใช้ IP ในวง Wi-Fi ให้อัตโนมัติ
PUBLIC_BASE_URL=

# ---- Google Sheets (เว้นว่าง = เก็บลงไฟล์ data/db.json ในเครื่อง) ----
# ID คือส่วนระหว่าง /d/ กับ /edit ใน URL ของชีต
GOOGLE_SHEET_ID=

# credentials ของ service account เลือกอย่างใดอย่างหนึ่ง:
# 1) วางไฟล์ credentials.json ไว้ในโฟลเดอร์นี้ (เหมาะกับรันในเครื่อง)
# 2) วางเนื้อหา JSON ทั้งไฟล์ในบรรทัดเดียว (เหมาะกับตอน deploy)
GOOGLE_CREDENTIALS_JSON=
# 3) ใส่แยกเป็นสองค่าจากไฟล์ credentials.json (ใช้แบบนี้บน Netlify)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
